# --- Server ---
# MongoDB connection string.
# Local (docker compose up -d):  mongodb://localhost:27017/tailor-pos
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/tailor-pos?retryWrites=true&w=majority
# NOTE: always include the /tailor-pos database name, or Mongo writes to "test".
MONGODB_URI=mongodb://localhost:27017/tailor-pos
# API port
PORT=5000

# --- Auth ---
# Signing key for API access tokens. Generate your own, never reuse this value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; a dev fallback is used when unset.
JWT_SECRET=
# How long a session lasts before re-login (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h
# Sites allowed to call the API from a browser (comma separated).
# Leave empty when the site and API share a domain, as they do on Vercel.
CORS_ORIGIN=
# Bootstrap Super Admin created by `npm run seed` (only if it does not exist yet)
SEED_ADMIN_USER=superadmin
SEED_ADMIN_PASS=ChangeMe@123

# --- Client ---
# Base URL of the API (used by the Next.js app)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
